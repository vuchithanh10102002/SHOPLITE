# Mau bien moi truong cho docker-compose.prod.yml.
# Cach dung:  cp .env.prod.example .env   roi dien gia tri that.
#
# TREN VPS:  chmod 600 .env  — file nay chua mat khau DB va secret JWT.
# File `.env` KHONG BAO GIO commit (da co trong .gitignore). Chi file .example
# nay duoc commit, va no khong duoc chua gia tri that.

# ─── Postgres ───────────────────────────────────────────────────────────────
# compose ghep 3 bien nay thanh DATABASE_URL, khong dat DATABASE_URL o day.
POSTGRES_USER=shoplite
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=shoplite

# ─── Cong HTTP cua nginx tren may host ──────────────────────────────────────
# Doi thanh 8080 neu may da co web server o 80.
HTTP_PORT=80

# ─── JWT ────────────────────────────────────────────────────────────────────
# TOI THIEU 32 ky tu (env.ts chan duoi nguong nay). Sinh moi:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Hai secret PHAI khac nhau: dung chung thi mot refresh token bi lo cung dung
# duoc nhu access token.
JWT_ACCESS_SECRET=sinh-chuoi-ngau-nhien-toi-thieu-32-ky-tu
JWT_REFRESH_SECRET=sinh-chuoi-khac-cung-toi-thieu-32-ky-tu
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── URL cong khai cua FE ───────────────────────────────────────────────────
# Dung cho CORS origin va cho link trong email (verify, reset password) — dat sai
# thi email gui ra link khong bam duoc.
CLIENT_URL=http://localhost

# ─── Cloudinary ─────────────────────────────────────────────────────────────
# Phai dung dang cloudinary://key:secret@cloud-name (env.ts chan tu dau).
CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name

# ─── SMTP ───────────────────────────────────────────────────────────────────
# Prod that thi dung Resend/SES/Postmark; Mailtrap chi de test.
SMTP_URL=smtp://user:pass@smtp.example.com:587
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user
SMTP_PASS=pass
SMTP_FROM=ShopLite <no-reply@shoplite.dev>

# ─── Nghiep vu ──────────────────────────────────────────────────────────────
# Ti le gia lap thanh toan that bai. Prod that de 0.
PAYMENT_FAIL_RATE=0
# 12 la muc hop ly cho prod (~250ms/hash). Ha xuong lam mat khau de bi do offline.
BCRYPT_COST=12
